# direnv config for induct_rec — see https://direnv.net
#
# induct_rec is a small, dependency-light package (numpy, torch,
# sentence-transformers) that induct_be installs from git. Most of the time you
# do not need a separate environment: induct_be's .venv already has induct_rec
# installed, so editing it there and reinstalling is the usual loop.
#
# This file exists for working on induct_rec on its own — cloned alone, or when
# you want its tests isolated from the backend's pinned stack.
#
# Enable once per machine:
#   sudo apt-get install -y direnv
#   echo 'eval "$(direnv hook bash)"' >> ~/.bashrc && exec bash
# Then, in this directory:
#   direnv allow

if [ -d .venv ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$PWD/.venv/bin"
else
  echo "induct_rec: no .venv here. Two options:"
  echo "  • work inside the backend's environment (usual):"
  echo "      cd ../induct_be && source .venv/bin/activate && pip install -e ../induct_rec"
  echo "  • or create a standalone one:"
  echo "      python3 -m venv .venv && .venv/bin/pip install -e '.[dev]' pytest"
fi

# So `python -c "import induct_rec"` works from a source checkout without an
# install, matching how induct_be runs it when not pip-installed.
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
