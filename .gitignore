# Python bytecode and build artefacts.
#
# The egg-info directory is regenerated by `pip install -e .`, and the .pyc
# files change on every run, so tracking them produced diffs on commits that
# touched no source at all.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtualenvs
.venv/
venv/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
